<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integration suite: runs against a real WordPress and a real database.

  PHPUnit 9.6, NOT the 10.5 the unit suite uses. This is forced by WordPress,
  not chosen: the WP core test library still calls
  PHPUnit\Util\Test::parseTestMethodAnnotations(), which PHPUnit 10 removed.
  Every test errors with "Call to undefined method" under 10.x — verified on
  6.8, 6.9, 7.0.3 and trunk, so it is not a matter of picking a newer branch.

  Consequence: the two suites cannot share one phpunit.xml, because they cannot
  share a PHPUnit major. The integration job installs 9.6 over the top before
  running this config; the unit suite keeps 10.5 from composer.lock.

  Re-check when WordPress adopts PHPUnit 10+ in core, at which point these two
  configs should be merged.
  PHPUnit 9, NOT the 10.5 the unit suite uses. This is not a preference — the
  WordPress test library cannot run on PHPUnit 10. Its WP_UnitTestCase::set_up()
  calls expectDeprecated(), which calls PHPUnit\Util\Test::parseTestMethodAnnotations()
  to read `@expectedDeprecated` docblocks, and PHPUnit 10 removed that method.
  Every test errors before its first assertion. This is true on WordPress 6.8,
  6.9, 7.0 and trunk alike, so it is not something a newer WordPress fixes.

  The unit suite stays on PHPUnit 10 (it never loads WordPress, so nothing there
  is affected) and CI installs the 9.x stack only for this suite. See the
  "Install the PHPUnit 9 test stack" step in .github/workflows/integration.yml.

  Failing on deprecations remains this suite's primary job, and it still does:

  - WordPress-level deprecations — _deprecated_function(), _deprecated_argument(),
    _deprecated_hook(), _doing_it_wrong() — are caught by WP_UnitTestCase itself,
    which fails any test that triggers one unexpectedly, plus the load-time hooks
    in tests/integration/bootstrap.php. That mechanism is entirely independent of
    the PHPUnit version and is where version incompatibilities actually surface.
  - PHP-level deprecations and notices are converted to exceptions below, which
    is the 9.x equivalent of 10's failOnDeprecation / failOnNotice.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/integration/bootstrap.php"
         cacheResultFile=".phpunit.cache/integration.result"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         convertWarningsToExceptions="true"
         convertNoticesToExceptions="true"
         convertErrorsToExceptions="true"
         failOnWarning="true"
         failOnRisky="true">
  <!--
    PHP-level deprecations are deliberately NOT converted to exceptions.
    WordPress core raises its own on newer PHP, and failing the suite on those
    would report a Memberistic incompatibility that is not one. The signal that
    matters — deprecations WordPress itself reports about the plugin — is
    asserted by LoadDeprecationsTest instead, which can name what triggered it.
  -->
         failOnRisky="true"
         convertDeprecationsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         convertErrorsToExceptions="true">
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">tests/integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
