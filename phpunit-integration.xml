<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integration suite: runs against a real WordPress and a real database.

  PHPUnit 9.6, NOT the 10.5 the unit suite uses. This is forced by WordPress,
  not chosen: the WP core test library still calls
  PHPUnit\Util\Test::parseTestMethodAnnotations(), which PHPUnit 10 removed.
  Every test errors with "Call to undefined method" under 10.x — verified on
  every line in .github/wordpress-targets.json and on trunk, so it is not a
  matter of picking a newer branch.

  Consequence: the two suites cannot share one phpunit.xml, because they cannot
  share a PHPUnit major. The integration job installs 9.6 over the top before
  running this config; the unit suite keeps 10.5 from composer.lock.

  Re-check when WordPress adopts PHPUnit 10+ in core, at which point these two
  configs should be merged.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/integration/bootstrap.php"
         cacheResultFile=".phpunit.cache/integration.result"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         convertWarningsToExceptions="true"
         convertNoticesToExceptions="true"
         convertErrorsToExceptions="true"
         failOnWarning="true"
         failOnRisky="true">
  <!--
    PHP-level deprecations are deliberately NOT converted to exceptions.
    WordPress core raises its own on newer PHP, and failing the suite on those
    would report a Memberistic incompatibility that is not one. The signal that
    matters — deprecations WordPress itself reports about the plugin — is
    asserted by LoadDeprecationsTest instead, which can name what triggered it.
  -->
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">tests/integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
